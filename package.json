{
  "name": "fantasy-draft-intelligence",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/shared-types",
    "packages/draft-engine",
    "packages/recommendation-engine",
    "apps/draft-room"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @fdi/draft-room",
    "build": "tsc -b && npm run build:vite --workspace @fdi/draft-room",
    "preview": "npm run preview --workspace @fdi/draft-room",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check": "npm run typecheck && npm test",
    "evaluate:recommendations": "npm run build && node scripts/evaluate_recommendations.mjs",
    "evaluate:recommendations:json": "npm run build && node scripts/evaluate_recommendations.mjs --json",
    "calibrate:real": "npm run build && node scripts/calibrate_real_data.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "typescript": "5.9.2",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  }
}
